alert icmp any any -> any any (msg:"ICMP Ping detecte !"; sid:1000001; rev:1;)
# Détection scan Nmap
alert tcp any any -> 192.168.10.2 any (msg:"Scan Nmap detecte !"; flags:S; threshold:type threshold, track by_src, count 20, seconds 3; sid:1000002; rev:1;)

# Détection SSH Brute Force
alert tcp any any -> 192.168.10.2 22 (msg:"SSH Brute Force detecte !"; threshold:type threshold, track by_src, count 5, seconds 10; sid:1000003; rev:1;)

# Détection ping flood
alert icmp any any -> 192.168.10.2 any (msg:"Ping Flood detecte !"; threshold:type threshold, track by_src, count 50, seconds 1; sid:1000004; rev:1;)
# Détection SQLi
alert tcp any any -> 192.168.10.2 80 (msg:"SQL Injection detecte !"; content:"union"; nocase; content:"select"; nocase; distance:0; sid:1000005; rev:2;)
alert tcp any any -> 192.168.10.2 80 (msg:"SQL Injection OR detecte !"; content:"or"; nocase; content:"1=1"; nocase; distance:0; sid:1000006; rev:2;)
# Détection XSS
alert tcp any any -> 192.168.10.2 80 (msg:"XSS Attack detecte !"; content:"<script>"; nocase; sid:1000007; rev:1;)

# Détection Nikto
alert tcp any any -> 192.168.10.2 any (msg:"Nikto Scanner detecte !"; content:"Nikto"; nocase; sid:1000008; rev:1;)

# Détection Metasploit
alert tcp any any -> 192.168.10.2 any (msg:"Metasploit detecte !"; content:"meterpreter"; nocase; sid:1000009; rev:1;)

# Détection SYN Flood
alert tcp any any -> 192.168.10.2 any (msg:"SYN Flood DDoS detecte !"; flags:S; threshold:type both, track by_src, count 100, seconds 5; sid:1000010; rev:1;)

# Détection FTP Brute Force
alert tcp any any -> 192.168.10.2 21 (msg:"FTP Brute Force detecte !"; threshold:type threshold, track by_src, count 5, seconds 10; sid:1000011; rev:1;)

# Détection Telnet
alert tcp any any -> 192.168.10.2 23 (msg:"Connexion Telnet detecte !"; sid:1000012; rev:1;)
